{
  "name": "to-the-edge-of-space-voyage",
  "version": "1.0.0",
  "private": true,
  "description": "To the Edge of Space: VOYAGE",
  "scripts": {
    "build:web": "node tools/build-web.js",
    "sync": "node tools/build-web.js && npx cap sync android",
    "open": "npx cap open android",
    "icons": "node tools/make-icons.js && npx capacitor-assets generate --android && node tools/compress-splash.js",
    "store:shots": "node tools/shots.js",
    "store:art": "node tools/store-art.js",
    "store": "node tools/shots.js && node tools/store-art.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capgo/native-purchases": "^8.9.13"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "puppeteer-core": "^25.17.0",
    "sharp": "^0.35.5"
  }
}
